<Project Sdk="Microsoft.NET.Sdk">
  <!-- The small console program for checks and, from stage 8, the scheduled jobs (8.4). No scheduled task in stage 1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>GrindPilot.Jobs</AssemblyName>
    <RootNamespace>GrindPilot.Jobs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Windows\Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\catalog\*.json" Link="data\catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
