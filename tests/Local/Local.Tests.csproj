<Project Sdk="Microsoft.NET.Sdk">
  <!-- The local suite: runs on a maintainer's PC only (it reads Steam's feed, and the test library outside the repo). CI skips it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GrindPilot.Local.Tests</AssemblyName>
    <RootNamespace>GrindPilot.Local.Tests</RootNamespace>
    <!-- GitHub Actions sets CI=true: there this project builds but isn't run as tests. -->
    <IsTestProject Condition="'$(CI)' == 'true'">false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\tools\CatalogSeed\CatalogSeed.csproj" />
  </ItemGroup>
</Project>
