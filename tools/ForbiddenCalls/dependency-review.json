    { "file": "setup_x64.exe", "symbol": "user32.dll!SendMessageW", "reason": "Its own splash window and dialogs (it creates them with CreateWindowExW); it imports no FindWindow or EnumWindows." },
    { "file": "GrindPilot-win-Setup.exe", "symbol": "user32.dll!SendMessageW", "reason": "Its own splash window and dialogs (it creates them with CreateWindowExW); it imports no FindWindow or EnumWindows." },
    { "file": "setup_x64.exe", "symbol": "user32.dll!PostMessageW", "reason": "WM_CLOSE to its own splash window (windows/splash.rs line 575)." },
